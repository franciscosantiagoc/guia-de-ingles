# Copia este archivo a ".env" (en la raíz del proyecto) y completa tu clave real.
# .env NUNCA debe subirse a git — ya está en .gitignore.

# Clave de API de Anthropic (console.anthropic.com -> API Keys).
# Es una cuenta de facturación separada de tu suscripción de Claude.ai.
ANTHROPIC_API_KEY=sk-ant-api03-tu-clave-aqui

# Opcional: modelo a usar (por defecto ya usa el más económico).
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
